#!/bin/sh

# Run lint-staged for formatting and linting on staged files only
npx lint-staged

# Anti-autocommit gate (lock-file + token discipline). See docs/dev/agent-prompts.md.
# This is the SOLE authorized commit gate — agents must use one of the slash-command
# prompts (/commit-ARD, /commit-adhoc, /merge-after-review) which write the token
# inline before invoking git commit. Direct `git commit` from a shell will fail here.
bash scripts/commit-gate-check.sh

# Maestro-specific lints (Build-ARD acceptance gates). See docs/ards/build-ard-acceptance.md.
# Pass ONLY the staged TS/JS files to each lint so unrelated pre-existing
# violations elsewhere in the tree do not block unrelated commits. Both scripts
# accept a path list as args (see their docstrings).
STAGED_TSJS=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' || true)
if [ -n "$STAGED_TSJS" ]; then
	# shellcheck disable=SC2086
	bash scripts/lint-no-suppression-markers.sh $STAGED_TSJS
	# shellcheck disable=SC2086
	bash scripts/lint-no-silent-error-swallow.sh $STAGED_TSJS
fi

# Everything else (tests, type checking) should run in CI
